{
  "name": "PublAI",
  "description": "AI-powered content transformation platform — cinematic green identity with high-authority typography",
  "version": "1.0.0",

  "colors": {
    "primary": "#61BA5E",
    "primaryLight": "#7DD47A",
    "primaryDark": "#4A9A48",
    "accent": "#61BA5E",
    "textDark": "#FFFFFF",
    "textMedium": "#B0B0B0",
    "textLight": "#666666",
    "bgLight": "#1A1A1A",
    "bgDark": "#0D0D0D",
    "bgOverlay": "rgba(97, 186, 94, 0.08)",
    "divider": "#2A2A2A",
    "shadow": "rgba(0, 0, 0, 0.6)",
    "grainOverlay": "rgba(255, 255, 255, 0.03)",
    "gradientMeshStart": "rgba(97, 186, 94, 0.15)",
    "gradientMeshEnd": "rgba(97, 186, 94, 0.02)"
  },

  "fonts": {
    "primary": "'Playfair Display', Georgia, 'Times New Roman', serif",
    "body": "'Inter', system-ui, -apple-system, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
  },

  "spacing": {
    "xs": 8,
    "sm": 16,
    "md": 24,
    "lg": 48,
    "xl": 80,
    "xxl": 120
  },

  "borderRadius": {
    "sm": 4,
    "md": 8,
    "lg": 16
  },

  "typography": {
    "h1": { "size": 80, "weight": 700, "font": "serif" },
    "h2": { "size": 60, "weight": 700, "font": "serif" },
    "h3": { "size": 44, "weight": 600, "font": "serif" },
    "body": { "size": 24, "weight": 400, "font": "body" },
    "label": { "size": 16, "weight": 500, "letterSpacing": 3, "font": "body" },
    "quote": { "size": 36, "weight": 300, "font": "serif", "letterSpacing": 1 }
  }
}
